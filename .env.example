# Async PostgreSQL connection string used by the API and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/macro_tracker_test
# Runtime environment name, such as development or production.
APP_ENV=development
# IANA timezone used when a user's timezone is not supplied by the CLI.
DEFAULT_TIMEZONE=America/Sao_Paulo
# Application log verbosity.
LOG_LEVEL=INFO
# Public origin used by OAuth issuer and MCP metadata URLs.
PUBLIC_BASE_URL=http://localhost:8000
# Google OAuth client credentials (required for production human login).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to create new accounts.
# ALLOWED_EMAILS=
# Show the OAuth consent page after Google login.
OAUTH_REQUIRE_CONSENT=true
# Development-only email used to resolve an existing OAuth user.
# DEV_LOGIN_EMAIL=you@example.com
# Use NullPool and disable asyncpg statement caching for serverless/pgbouncer.
# Vercel auto-detects this from VERCEL when SERVERLESS is omitted.
SERVERLESS=false
